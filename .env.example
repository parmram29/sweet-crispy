# Copy this file to .env and fill in real values. Never commit .env.
#
# NOTE: none of this is used by the live site anymore. Ordering, the menu,
# and WhatsApp/notification config all moved to public/js/config.js and
# public/js/data/menu.js — see the README. This file only still matters if
# you're running the legacy server.js backend locally to poke at the old
# (now unused) /api/* routes.

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sweet_crispy

# ── Server ────────────────────────────────────────────────────
PORT=3000
# Public URL of this site, used to build gateway redirect links (no trailing slash)
CLIENT_URL=http://localhost:3000

# ── Staff login ───────────────────────────────────────────────
# The server REFUSES TO START if this is missing, well-known, or shorter than
# 8 characters. Mix letters and digits — a 4-digit PIN is brute-forceable
# within days even behind the login rate limit. Staff exchange this once for
# a session cookie.
ADMIN_PIN=change-me

# ── Deployment ────────────────────────────────────────────────
# Set to 'production' in production. Enables the HTTPS redirect and adds the
# Secure flag to the staff session cookie.
# NODE_ENV=production

# Set ONLY if a reverse proxy (nginx, Cloudflare) sits in front of Node — to
# the number of proxy hops; nginx on the same host is 1.
#   unset behind a proxy → every client shares one rate-limit bucket, so one
#                          abuser locks the whole restaurant out of ordering
#   set with no proxy    → X-Forwarded-For is spoofable and all limits bypass
# TRUST_PROXY=1

# Only set CORS_ORIGIN if the frontend is served from a different host than
# this API. Left unset, cross-origin browser requests are refused, which is
# what you want for a single-server deployment.
# CORS_ORIGIN=https://your-frontend-domain

# ── Card payments ─────────────────────────────────────────────
# Which gateway handles cards:
#   none   cash only — the card option never appears (safe default)
#   epay   Republic Bank EPay  (see lib/payments/epay.js — needs completing)
#   wipay  WiPay               (see lib/payments/wipay.js — needs completing)
#
# Both gateways process Visa and Mastercard. Which card brands you can accept
# is decided by your merchant account with the gateway, not by this setting.
PAYMENT_PROVIDER=none

# ── Republic Bank EPay ────────────────────────────────────────
# From the merchant integration pack. The secret signs requests and verifies
# callbacks — it must NEVER be exposed to the browser or committed to git.
# EPAY_MERCHANT_ID=
# EPAY_SECRET=
# EPAY_CHECKOUT_URL=

# ── WiPay ─────────────────────────────────────────────────────
# From your WiPay merchant account. Same rule: server-side only.
# WIPAY_ACCOUNT_ID=
# WIPAY_API_KEY=
# WIPAY_API_URL=
# WIPAY_ENV=sandbox

# ── Contact ───────────────────────────────────────────────────
WHATSAPP_NUMBER=14735369931

# ── New-order email notification (optional) ─────────────────────
# Emails the owner the instant a cash order is placed. Leave both unset to
# skip this entirely — nothing else depends on it.
# Get RESEND_API_KEY free at https://resend.com (no domain/business
# verification needed to send to your own account email).
# RESEND_API_KEY=
# OWNER_EMAIL=
