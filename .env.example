# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sweet_crispy

# ── Server ────────────────────────────────────────────────────
PORT=3000
# Public URL of this site, used to build Stripe redirect links (no trailing slash)
CLIENT_URL=http://localhost:3000

# ── Staff login ───────────────────────────────────────────────
ADMIN_PIN=change-me

# ── Stripe (card payments) ────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys — use the test keys
# (pk_test_ / sk_test_) until you're ready to go live with pk_live_ / sk_live_.
# The secret key must NEVER be exposed to the browser or committed to git.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From https://dashboard.stripe.com/webhooks after adding an endpoint at
# <CLIENT_URL>/api/payments/webhook, subscribed to checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Contact ───────────────────────────────────────────────────
WHATSAPP_NUMBER=14735369931
